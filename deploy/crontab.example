# Thay cho pm2 nếu muốn dùng crontab của hệ thống.
#   crontab -e  → dán vào, sửa /opt/banbot thành thư mục thật
# Log ghi vào logs/ (đã nằm trong .gitignore). Nhớ `npm run build` trước.

SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin
APP=/opt/banbot

# Gửi — mỗi 5 phút
*/5 * * * *        cd $APP && node dist/jobs/send.js   >> logs/send.log   2>&1
# Đồng bộ tệp khách — mỗi 15 phút (3h sáng địa phương quét đầy đủ, còn lại quét nhanh khách mới)
# flock: lượt quét đầy đủ dài hơn 15 phút thì lượt sau tự bỏ, không chạy chồng
5,20,35,50 * * * * cd $APP && flock -n /tmp/banbot-sync.lock node dist/jobs/sync.js >> logs/sync.log 2>&1
# Đối chiếu đơn POS — mỗi 15 phút (dừng chuỗi cho khách đã chốt)
8,23,38,53 * * * * cd $APP && node dist/jobs/pos.js    >> logs/pos.log    2>&1
# Giám sát sức khoẻ — mỗi 15 phút
2,17,32,47 * * * * cd $APP && node dist/jobs/health.js >> logs/health.log 2>&1
# Webhook và dashboard KHÔNG chạy bằng cron — dùng systemd hoặc pm2 vì phải chạy liên tục
